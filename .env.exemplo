# =====================================================================
# Configuração do servidor. Copie este arquivo para ".env" e preencha.
#   cp .env.exemplo .env
# O arquivo .env NUNCA vai para o Git (tem senha).
# =====================================================================

# "production" na VPS; "development" no seu computador
NODE_ENV=production

# Porta interna do Node. O Nginx recebe na 80/443 e repassa para cá.
PORTA=3000

# 127.0.0.1 = só aceita conexões da própria máquina (do Nginx).
# Assim ninguém acessa o Node direto pela internet, pulando o Nginx.
HOST=127.0.0.1

# Onde fica o arquivo do banco. Na VPS, FORA da pasta do código,
# para que atualizar o código nunca apague os dados.
DB_PATH=/var/lib/formulario/inscricoes.db

# Acesso à área administrativa (/admin): lista, relatório e exclusão.
# Use uma senha forte e longa. Se ADMIN_SENHA ficar vazia, a área admin fica DESLIGADA.
ADMIN_USUARIO=admin
ADMIN_SENHA=
